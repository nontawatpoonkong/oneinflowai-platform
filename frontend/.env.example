# URL of the FastAPI backend. Next.js proxies /api/v1/* to this origin
# (see next.config.mjs rewrites), so the browser stays same-origin (no CORS).
BACKEND_URL=http://localhost:8000

# Optional: point the Axios client at an absolute API base instead of the
# same-origin proxy. Leave unset to use the proxy (recommended).
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
