# ---- App ----
APP_NAME=OneInFlow Platform
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- PostgreSQL ----
# When running via docker-compose, POSTGRES_HOST is overridden to "postgres".
# For running the app locally against compose services, use "localhost".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=oneflowai
POSTGRES_PASSWORD=oneflowai
POSTGRES_DB=oneflowai
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- Qdrant ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ---- JWT ----
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Tenancy ----
BASE_DOMAIN=oneflow.ai

# ---- AI ----
OPENAI_API_KEY=
GENERATION_PROVIDER=openai
OPENAI_MODEL=gpt-5.5
GENERATION_TEMPERATURE=0.2
DEMO_CHAT_RATE_LIMIT_REQUESTS=5
DEMO_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
DEMO_CHAT_MAX_INPUT_CHARS=1000
WEBCHAT_RATE_LIMIT_REQUESTS=30
WEBCHAT_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
GENERATION_MAX_OUTPUT_TOKENS=800
GENERATION_REQUEST_TIMEOUT_SECONDS=45
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

# ---- Email verification ----
EMAIL_PROVIDER=development
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=OneInFlow
EMAIL_VERIFICATION_OTP_TTL_SECONDS=300
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL_SECONDS=600
OTP_HASH_SECRET=

# ---- Knowledge storage ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=storage
KNOWLEDGE_MAX_FILE_SIZE_BYTES=10485760
KNOWLEDGE_MAX_EXTRACTED_CHARACTERS=2000000
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=10000
QDRANT_KNOWLEDGE_COLLECTION=knowledge_chunks
KNOWLEDGE_RETRIEVAL_DEFAULT_LIMIT=5
KNOWLEDGE_RETRIEVAL_MAX_LIMIT=20
KNOWLEDGE_RETRIEVAL_MAX_QUERY_CHARACTERS=2000
KNOWLEDGE_RETRIEVAL_SCORE_THRESHOLD=
RAG_MAX_CONTEXT_CHARACTERS=12000
RAG_MAX_SOURCES=8
PAYMENT_EVIDENCE_MAX_FILE_SIZE_BYTES=5242880
SLIP_VERIFICATION_PROVIDER=development
EASYSLIP_API_KEY=
SLIP_VERIFICATION_TIMEOUT_SECONDS=10
# Production must use "generation"; development is only for local/test use.
ACTION_COLLECTION_PROVIDER=development
ACTION_COLLECTION_SESSION_TTL_MINUTES=30

# ---- External channels (base64-encoded 32-byte key; never commit a real key) ----
CHANNEL_CREDENTIAL_ENCRYPTION_KEY=
CHANNEL_CREDENTIAL_KEY_VERSION=v1
CHANNEL_PROVIDER_TIMEOUT_SECONDS=10
CHANNEL_WEBHOOK_MAX_BYTES=1000000
